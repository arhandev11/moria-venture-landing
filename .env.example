# MySQL 8 connection for the admin area and the /kneks page data.
# Format: mysql://USER:PASSWORD@HOST:PORT/SCHEMA (URL-encode special characters).
DATABASE_URL=mysql://moria_venture:change-me@127.0.0.1:3306/moria_venture

# Keys the admin session token hash. At least 32 random characters, e.g.
#   openssl rand -base64 48
# Changing it signs every admin out.
SESSION_SECRET=

# Where uploaded SME images are stored. Relative paths resolve from the app's
# working directory. Must live outside public/ (files added there after
# `next build` are not served) and must survive deploys.
UPLOAD_DIR=storage/uploads

# Optional, for self-hosting behind more than one instance: keeps Server
# Action references stable across instances and deploys.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
